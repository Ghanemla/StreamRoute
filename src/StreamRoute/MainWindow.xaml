<Window x:Class="StreamRoute.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamRoute"
        Width="540" Height="760"
        MinWidth="540" MinHeight="760"
        MaxWidth="540" MaxHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Foreground="#F5F7FA"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0B0E12"/>
        <SolidColorBrush x:Key="Panel" Color="#11161C"/>
        <SolidColorBrush x:Key="Panel2" Color="#151B22"/>
        <SolidColorBrush x:Key="Border" Color="#28313B"/>
        <SolidColorBrush x:Key="Text" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="Muted" Color="#93A0AE"/>
        <SolidColorBrush x:Key="Accent" Color="#36C98F"/>
        <SolidColorBrush x:Key="Danger" Color="#DF6B6B"/>

        <DataTemplate x:Key="ComboItemTemplate">
            <Grid Margin="0,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding DisplayName}"
                           Foreground="{StaticResource Text}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="1"
                           Margin="0,3,0,0"
                           Text="{Binding Detail}"
                           Foreground="{StaticResource Muted}"
                           FontSize="11.5"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA8B6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="1,0,0,8"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="5,2">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#202833"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#25362F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7,44,7"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="ItemTemplate" Value="{StaticResource ComboItemTemplate}"/>
            <Setter Property="MaxDropDownHeight" Value="330"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="OuterBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="11"/>

                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              IsHitTestVisible="False"/>

                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0"
                                       Text="⌄"
                                       Foreground="#A7B1BD"
                                       FontSize="18"
                                       IsHitTestVisible="False"/>

                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Margin="0,7,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#151B22"
                                        BorderBrush="#303A45"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <ScrollViewer Margin="3" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#44505E"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#36C98F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="#171D25"/>
            <Setter Property="Foreground" Value="#DDE3EA"/>
            <Setter Property="BorderBrush" Value="#2B3540"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#202833"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="58"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#07110D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Background="{StaticResource Panel}"
            BorderBrush="#222A33"
            BorderThickness="1"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#10151B"
                    CornerRadius="18,18,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="32" Height="32" CornerRadius="9" Background="#18372B" VerticalAlignment="Center">
                        <TextBlock Text="↗"
                                   Foreground="{StaticResource Accent}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="StreamRoute" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Per-app stream audio routing" FontSize="10.5" Foreground="#74808D"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Width="36" Height="36" Margin="4,0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#9EA8B3" FontSize="19"
                            Content="—" Click="MinimizeButton_Click" Cursor="Hand"/>
                    <Button Grid.Column="3"
                            Width="36" Height="36"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#9EA8B3" FontSize="16"
                            Content="✕" Click="CloseButton_Click" Cursor="Hand"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,22,24,22">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="APPLICATION" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="Choose the program whose audio you want to reroute."
                                       Foreground="#6F7A87" FontSize="11.5" Margin="1,-3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Content="↻  Refresh" Click="RefreshButton_Click"/>
                    </Grid>

                    <ComboBox x:Name="ApplicationCombo"
                              Style="{StaticResource ModernComboBox}"
                              SelectionChanged="ApplicationCombo_SelectionChanged"
                              IsTextSearchEnabled="True"/>

                    <TextBlock Text="STREAM OUTPUT" Style="{StaticResource SectionLabel}" Margin="1,23,0,8"/>
                    <ComboBox x:Name="StreamOutputCombo"
                              Style="{StaticResource ModernComboBox}"
                              SelectionChanged="StreamOutputCombo_SelectionChanged"/>

                    <TextBlock Text="NORMAL OUTPUT" Style="{StaticResource SectionLabel}" Margin="1,23,0,8"/>
                    <ComboBox x:Name="NormalOutputCombo"
                              Style="{StaticResource ModernComboBox}"
                              SelectionChanged="NormalOutputCombo_SelectionChanged"/>

                    <Border Margin="0,24,0,0"
                            Padding="16,14"
                            Background="#0E1318"
                            BorderBrush="#27313A"
                            BorderThickness="1"
                            CornerRadius="11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#66717D" VerticalAlignment="Top" Margin="0,5,11,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="CURRENT ROUTING" Foreground="#7E8A97" FontSize="10.5" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CurrentRouteText"
                                           Margin="0,4,0,0"
                                           Text="Choose an application"
                                           Foreground="#E8EDF2"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="StatusSubText"
                                           Margin="0,3,0,0"
                                           Text="StreamRoute changes Windows' per-app output and can then be closed."
                                           Foreground="#788491"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="FeedbackText"
                               Margin="2,12,2,0"
                               MinHeight="18"
                               Text=""
                               Foreground="#DF8A8A"
                               FontSize="11.5"
                               TextWrapping="Wrap"/>

                    <Button x:Name="StreamToggleButton"
                            Margin="0,10,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Content="STREAM ON"
                            Click="StreamToggleButton_Click"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#6F7B88"
                                   FontSize="10.8"
                                   Text="Closing the app exits completely. Routing stays applied."/>
                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Content="Reset to Windows Default"
                                Click="ResetButton_Click"/>
                    </Grid>

                    <Border Margin="0,18,0,0" Height="1" Background="#222A33"/>
                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#596572"
                               FontSize="10.5"
                               Text="StreamRoute v0.1.5  ·  Windows 10/11 x64"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
